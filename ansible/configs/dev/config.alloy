// Sample external Alloy config for dev environment
// This file is managed externally; set alloy_config_mode=external and point CONFIG_SOURCE to this file.

logging {
  level  = "info"
  format = "logfmt"
}

// MySQL exporter – connect to localhost:3306 with user root
prometheus.exporter.mysql "mysql" {
  data_source_name = "root@(localhost:3306)/"
}

// Scrape the exporter and forward metrics to the remote_write endpoint
prometheus.scrape "mysql" {
  targets        = prometheus.exporter.mysql.mysql.targets
  forward_to     = [prometheus.remote_write.primary.receiver]
  job_name       = "mysql"
  scrape_interval = "60s"
}

// Self‑observability – expose internal Alloy metrics on port 12345
prometheus.scrape "alloy_self" {
  targets = [{ __address__ = "127.0.0.1:12345" }]
  forward_to = [prometheus.remote_write.primary.receiver]
  job_name = "alloy_self"
  scrape_interval = "60s"
}

// Remote write to development Mimir
prometheus.remote_write "primary" {
  endpoint {
    url = "https://mimir.dev.example.com/api/v1/push"
    basic_auth {
      username = "dev-push"
      password = "REPLACE_ME"
    }
  }
}