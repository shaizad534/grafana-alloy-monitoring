// ********************************************************************
// Grafana Alloy configuration
// Generated by Ansible role alloy_agent - DO NOT EDIT MANUALLY
// Host        : {{ inventory_hostname }}
// Environment : {{ alloy_environment | default('unspecified') }}
// Alloy version: {{ alloy_version }}
// ********************************************************************

logging {
  level  = {{ alloy_log_level | to_json }}
  format = {{ alloy_log_format | to_json }}
}

{% if alloy_resource_memory_limit | default('') | length > 0 or alloy_resource_cpu_limit | default('') | length > 0 %}
resource {
  {% if alloy_resource_memory_limit | default('') | length > 0 %}
  memory_limit = {{ alloy_resource_memory_limit | to_json }}
  {% endif %}
  {% if alloy_resource_cpu_limit | default('') | length > 0 %}
  cpu_limit = {{ alloy_resource_cpu_limit | to_json }}
  {% endif %}
}
{% endif %}

{% set _forward_to = (alloy_forward_to | default([])) | default([]) %}
{% if alloy_remote_write_url | default('') | length > 0 %}
prometheus.remote_write {{ alloy_remote_write_name | to_json }} {
  endpoint {
    url = {{ alloy_remote_write_url | to_json }}
{% if alloy_remote_write_username | default('') | length > 0 %}
    basic_auth {
      username = {{ alloy_remote_write_username | to_json }}
      password = {{ alloy_remote_write_password | to_json }}
    }
{% endif %}
  }
}
{% set _ = _forward_to.append('prometheus.remote_write.' ~ alloy_remote_write_name ~ '.receiver') %}
{% endif %}

{% for label, exp in alloy_exporters | dict2items | sort(attribute='key') %}
{% if exp.enabled | default(false) %}
{% set etype = exp.type | default(label) %}

{% set _args = exp | dict2items | rejectattr('key', 'in', ['enabled', 'type', 'data_source_name', 'connection_string', 'mongodb_uri']) | list %}
{% if etype == 'mysql' %}
prometheus.exporter.mysql {{ label | to_json }} {
  data_source_name = {{ exp.data_source_name | to_json }}
{% elif etype == 'oracledb' %}
prometheus.exporter.oracledb {{ label | to_json }} {
  connection_string = {{ exp.connection_string | to_json }}
{% elif etype == 'mssql' %}
prometheus.exporter.mssql {{ label | to_json }} {
  connection_string = {{ exp.connection_string | to_json }}
{% elif etype == 'mongodb' %}
prometheus.exporter.mongodb {{ label | to_json }} {
  mongodb_uri = {{ exp.mongodb_uri | default(exp.connection_string) | to_json }}
{% endif %}
{% for kv in _args %}
  {{ kv.key }} = {{ kv.value | to_json }}
{% endfor %}

}

prometheus.scrape {{ label | to_json }} {
  targets        = prometheus.exporter.{{ etype }}.{{ label }}.targets
  forward_to     = {{ _forward_to | to_json }}
  job_name       = {{ (alloy_job_name_prefix | default('')) ~ etype | to_json }}
  scrape_interval = {{ alloy_scrape_interval | to_json }}
}

{% if alloy_scrape_self | default(false) %}
prometheus.scrape "alloy_self" {
  targets = [{ __address__ = {{ ('127.0.0.1:' ~ alloy_http_port) | to_json }} }]
  forward_to = {{ _forward_to | to_json }}
  job_name = {{ ((alloy_job_name_prefix | default('')) ~ 'alloy') | to_json }}
  scrape_interval = {{ alloy_scrape_interval | to_json }}
}
{% endif %}

{% endif %}
{% endfor %}

{% if alloy_additional_config | default('') | length > 0 %}

// ----- alloy_additional_config (operator provided) -----
{{ alloy_additional_config }}
{% endif %}